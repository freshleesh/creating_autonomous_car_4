<launch>
  <!--
    mppi.launch.xml
    ====================
    MPPI controller + global waypoints publisher (+ optional LiDAR detection).

    Run AFTER:
      sim  : ros2 launch stack_master low_level.launch.xml sim:=true map:=f
      real : ros2 launch stack_master middle_level.launch.xml map:=f

    Usage:
      sim  : ros2 launch stack_master mppi.launch.xml map:=f sim:=true
      sim w/ detection :
             ros2 launch stack_master mppi.launch.xml map:=f sim:=true use_detection:=true
      real : ros2 launch stack_master mppi.launch.xml map:=f
  -->

  <arg name="map"            description="Map name (folder in stack_master/maps/)"/>
  <arg name="sim"            default="false" description="true: sim (/vesc/odom from gym_bridge, map frame); false: real car (remap to /car_state/odom from EKF)"/>
  <arg name="use_detection"  default="false" description="true: subscribe to /detections and add an opponent keep-out cost; also launches the detection_sh detector"/>
  <arg name="config"         default="$(find-pkg-share stack_master)/config/mppi.yaml"/>
  <arg name="detection_config"
       default="$(find-pkg-share stack_master)/config/detection_sh_v2.yaml"
       description="YAML tunables for detection_sh_v2 (the /detections source)"/>

  <!-- Global waypoints publisher (loads stack_master/maps/<map>/global_waypoints.csv) -->
  <node pkg="planner" exec="waypoint_publisher" name="waypoint_publisher" output="screen">
    <param name="map_name" value="$(var map)"/>
  </node>

  <!-- Optional perception: detection_sh_v2 reference-line proximity detector.
       Gates the scan by range, transforms each point to the map frame and keeps
       only points within ref_dist_thresh (0.2 m) of the reference line, then
       publishes every survivor as an Obstacle (ObstacleArray, frame=laser) on
       /detections. MPPI transforms them back to map frame using ego pose +
       laser_x_offset (0.27, matched by laser_to_base_x). Needs /global_waypoints
       (waypoint_publisher above). Tunables: config/detection_sh_v2.yaml. -->
  <group if="$(var use_detection)">
    <group if="$(var sim)">
      <node pkg="perception" exec="detection_sh_v2" name="detection_sh_v2" output="screen">
        <param from="$(var detection_config)"/>
        <param name="odom_topic" value="/vesc/odom"/>
      </node>
    </group>
    <group unless="$(var sim)">
      <node pkg="perception" exec="detection_sh_v2" name="detection_sh_v2" output="screen">
        <param from="$(var detection_config)"/>
        <param name="odom_topic" value="/car_state/odom"/>
      </node>
    </group>
  </group>

  <!-- Lap analyzer: prints lap time / top speed / distance / tracking-error
       integral per lap, and publishes the driven trajectory as a 3-D LINE_STRIP
       (z = speed). Subscribes /global_waypoints + odom. -->
  <group if="$(var sim)">
    <node pkg="controller" exec="lap_analyzer" name="lap_analyzer" output="screen">
      <param name="odom_topic" value="/vesc/odom"/>
    </node>
  </group>
  <group unless="$(var sim)">
    <node pkg="controller" exec="lap_analyzer" name="lap_analyzer" output="screen">
      <param name="odom_topic" value="/car_state/odom"/>
    </node>
  </group>

  <!-- MPPI controller.
       sim : gym_bridge publishes /vesc/odom directly in map frame (GT), no remap needed.
       real: VESC /vesc/odom is wheel-only in odom frame (drifts), use EKF-filtered
             /car_state/odom (map frame) by remapping the subscription. -->
  <group if="$(var sim)">
    <node pkg="controller" exec="mppi_node" name="mppi" output="screen">
      <param from="$(var config)"/>
      <param name="use_detection" value="$(var use_detection)"/>
    </node>
  </group>
  <group unless="$(var sim)">
    <node pkg="controller" exec="mppi_node" name="mppi" output="screen">
      <param from="$(var config)"/>
      <param name="use_detection" value="$(var use_detection)"/>
      <remap from="/vesc/odom" to="/car_state/odom"/>
    </node>
  </group>

</launch>
